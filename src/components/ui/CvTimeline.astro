---
import type { TimelineEntry } from '@/types/cv';
import { richText } from '@/lib/utils';

interface Props {
	entries: TimelineEntry[]
	colored: boolean
}

const { entries, colored } = Astro.props
---

<ul
	class='timeline timeline-snap-icon max-md:timeline-compact timeline-vertical'
>
	{
		entries.map((entry, index) => (
			<li>
				<div class='timeline-middle'>
					<svg
						xmlns='http://www.w3.org/2000/svg'
						viewBox='0 0 20 20'
						fill='currentColor'
            class:list={[{ 'text-primary': colored }, 'h-5 w-5']}
					>
						<path
							fill-rule='evenodd'
							d='M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z'
							clip-rule='evenodd'
						/>
					</svg>
				</div>
				<div
					class={`${index % 2 === 0 ? 'timeline-start' : 'timeline-end'} mb-10 md:text-end`}
				>
					<time class='font-mono italic'>{entry.time}</time>
					<div class='text-lg font-black'>{entry.title}</div>
					<div>{entry.organization}</div>
					<div>{entry.location}</div>
					{entry.descriptionHtml && <div class={`mt-2 ${richText}`} set:html={entry.descriptionHtml} />}
					{entry.detailsHtml.map((detail) => (
						<div class={`text-sm text-base-content/70 ${richText}`} set:html={detail} />
					))}
				</div>
        <hr class:list={[{ 'bg-primary/30': colored }]} />
			</li>
		))
	}
</ul>
