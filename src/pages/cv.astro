---
import Layout from '@/layouts/Layout.astro'
import CvTimeline from '@/components/ui/CvTimeline.astro'
import CvEventList from '@/components/ui/CvEventList.astro'
import IconRenderer from '@/components/ui/IconRenderer.astro'
import { highlightAuthor, richText } from '@/lib/utils'
import type { CvSection, Publication } from '@/types/cv'

// Generated from public/cv/CV.tex by `npm run update:cv`.
import {
	cvSections,
	researchProfile,
	appointments,
	education,
	teaching,
	supervision,
	service,
	visits,
	honors,
	skills,
	researchInterests,
	talks,
	languages,
	memberships,
	interests,
} from '@/data/cv'

// Publications are not taken from CV.tex: they come from the same DBLP data
// as the Publications page.
import publicationsData from '@/data/publications.json'

// The journey timelines always open the page; every other section follows
// the order of CV.tex.
const timelines = { appointments, education }
const isTimeline = (section: CvSection): section is CvSection & { key: keyof typeof timelines } =>
	section.key in timelines
const timelineSections = cvSections.filter(isTimeline)
const otherSections = cvSections.filter((section) => !isTimeline(section))

// DBLP lists most papers twice, as the venue version and as its ePrint. Show
// each paper once: the published version, with a link to its ePrint.
const normalizeTitle = (title: string) => title.toLowerCase().replace(/[^a-z0-9]/g, '')
const versionsByTitle = new Map<string, Publication[]>()
for (const publication of publicationsData.publications as Publication[]) {
	const key = normalizeTitle(publication.title)
	versionsByTitle.set(key, [...(versionsByTitle.get(key) ?? []), publication])
}
const publications = [...versionsByTitle.values()]
	.map((versions) => {
		const published = versions.find((version) => version.type !== 'preprint')
		const eprint = versions.find((version) => version.type === 'preprint')
		const paper = published ?? eprint!
		return {
			...paper,
			title: paper.title.replace(/\.$/, ''),
			// Drop DBLP's homonym numbers, e.g. "Kai Hu 0001".
			authors: paper.authors.replace(/ \d{4}(?=,|$)/g, ''),
			eprintUrl: published && eprint ? eprint.url : '',
		}
	})
	.sort((a, b) => b.year - a.year || Number(a.type === 'preprint') - Number(b.type === 'preprint'))
---

<Layout title='Curriculum Vitae - Hosein Hadipour'>
<div style="font-family: 'Quantico', sans-serif;">
	<!-- CV Header with Download Link -->
	<section class='mb-12'>
		<div class='flex flex-wrap justify-between items-center gap-4 mb-8'>
			<h1 class='text-4xl font-bold'>Curriculum Vitae</h1>
			<a
				href='/cv/CV.pdf'
				download='Hosein_Hadipour_CV.pdf'
				class='btn btn-primary gap-2 whitespace-nowrap'
				target='_blank'
			>
				<svg class='w-4 h-4' fill='currentColor' viewBox='0 0 20 20' aria-hidden='true'>
					<path fill-rule='evenodd' d='M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z' clip-rule='evenodd'></path>
				</svg>
				Download PDF
			</a>
		</div>
		{researchProfile.map((paragraph) => (
			<p class={`text-lg text-base-content/70 mb-4 ${richText}`} set:html={paragraph} />
		))}
	</section>

	<!-- Journey timelines -->
	{timelineSections.map((section) => (
		<section id={section.key} class='mb-12 scroll-mt-8'>
			<h2 class='text-2xl font-bold mb-6 border-b pb-2'>{section.title}</h2>
			<CvTimeline entries={timelines[section.key]} colored={true} />
		</section>
	))}

	{otherSections.map((section) => (
		<section id={section.key} class='mb-12 scroll-mt-8'>
			<h2 class='text-2xl font-bold mb-6 border-b pb-2'>{section.title}</h2>

			{section.key === 'publications' && (
				<>
					<p class='text-sm text-base-content/60 mb-6'>
						{publications.length} papers, newest first. Search and filter them on the
						<a href='/papers' class='text-primary hover:underline'>Publications</a> page.
					</p>
					<ol class='space-y-5'>
						{publications.map((publication) => (
							<li class='border-l-2 border-primary/30 pl-4'>
								<a href={publication.url} target='_blank' rel='noopener noreferrer' class='font-semibold hover:text-primary transition-colors'>
									{publication.title}
								</a>
								<p class='text-sm text-base-content/70 mt-1' set:html={highlightAuthor(publication.authors)} />
								<p class='text-sm mt-1'>
									<span class='italic'>{publication.venue}</span> · {publication.year}
									{publication.type === 'preprint' && <span class='badge badge-ghost badge-sm ml-2'>Preprint</span>}
									{publication.eprintUrl && (
										<a href={publication.eprintUrl} target='_blank' rel='noopener noreferrer' class='text-primary hover:underline ml-3'>ePrint</a>
									)}
								</p>
							</li>
						))}
					</ol>
				</>
			)}

			{section.key === 'teaching' && (
				<>
					{supervision.length > 0 && (
						<dl class='grid grid-cols-1 sm:grid-cols-[9rem_1fr] gap-x-6 gap-y-2 mb-8'>
							{supervision.map((item) => (
								<>
									<dt class='font-semibold text-primary'>{item.label}</dt>
									<dd class={`mb-2 sm:mb-0 ${richText}`} set:html={item.descriptionHtml} />
								</>
							))}
						</dl>
					)}
					<div class='space-y-4'>
						{teaching.map((item) => (
							<div class='border-l-2 border-primary pl-4'>
								<div class='flex flex-wrap justify-between items-baseline gap-x-4'>
									<h3 class='text-lg font-semibold'>{item.role}</h3>
									<span class='font-mono text-sm text-base-content/60'>{item.time}</span>
								</div>
								<p class='text-primary font-medium'>
									{item.institution}{item.location && <span class='text-base-content/60 font-normal'>, {item.location}</span>}
								</p>
								{item.course && <p class='text-sm mt-1'>Course: {item.course}</p>}
								{item.descriptionHtml && <p class={`text-sm mt-1 text-base-content/80 ${richText}`} set:html={item.descriptionHtml} />}
							</div>
						))}
					</div>
				</>
			)}

			{section.key === 'service' && (
				<ul class='grid grid-cols-1 md:grid-cols-2 gap-3'>
					{service.map((item) => (
						<li class='flex justify-between items-baseline gap-4 p-3 rounded-lg bg-base-200 border border-primary/20'>
							{item.url ? (
								<a href={item.url} target='_blank' rel='noopener noreferrer' class='font-medium hover:text-primary transition-colors'>{item.venue}</a>
							) : (
								<span class='font-medium'>{item.venue}</span>
							)}
							<span class={`text-xs text-right shrink-0 ${item.highlight ? 'text-primary font-semibold' : 'text-base-content/60'}`}>
								{item.role}
							</span>
						</li>
					))}
				</ul>
			)}

			{section.key === 'visits' && <CvEventList events={visits} />}

			{section.key === 'honors' && (
				<div class='space-y-4'>
					{honors.map((item) => (
						<div class='border-l-2 border-primary/40 pl-4 flex items-start gap-3'>
							<IconRenderer name='trophy' className='text-primary mt-1 shrink-0' />
							<div class='flex-1'>
								<div class='flex flex-wrap justify-between items-baseline gap-x-4'>
									<h3 class='text-lg font-semibold'>
										<span class='text-primary'>{item.distinction}</span> · {item.event}
									</h3>
									<span class='font-mono text-sm text-base-content/60'>{item.time}</span>
								</div>
								<p class='text-sm text-base-content/70'>{[item.location, item.date].filter(Boolean).join(' · ')}</p>
								{item.detailsHtml && <p class={`text-sm ${richText}`} set:html={item.detailsHtml} />}
							</div>
						</div>
					))}
				</div>
			)}

			{section.key === 'skills' && (
				<dl class='grid grid-cols-1 sm:grid-cols-[9rem_1fr] gap-x-6 gap-y-3'>
					{skills.map((group) => (
						<>
							<dt class='font-semibold text-primary sm:pt-0.5'>{group.category}</dt>
							<dd class='flex flex-wrap gap-2 mb-3 sm:mb-0'>
								{group.items.map((skill) => <span class='badge badge-outline'>{skill}</span>)}
							</dd>
						</>
					))}
				</dl>
			)}

			{section.key === 'researchInterests' && (
				<ul class='grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-2'>
					{researchInterests.map((interest) => (
						<li class='flex gap-2'>
							<span class='text-primary' aria-hidden='true'>›</span>
							<span class={richText} set:html={interest} />
						</li>
					))}
				</ul>
			)}

			{section.key === 'talks' && <CvEventList events={talks} />}

			{section.key === 'languages' && (
				<div class='grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4'>
					{languages.map((lang) => (
						<div class='p-4 bg-base-200 rounded-lg flex items-center space-x-3'>
							<div class='text-primary'>
								<IconRenderer name='globe' size='md' />
							</div>
							<div class='flex-1'>
								<h3 class='font-semibold text-base-content'>{lang.language}</h3>
								<p class='text-sm text-base-content/70'>{lang.level}</p>
								<div class='flex items-center mt-1 space-x-1' role='img' aria-label={`Proficiency ${lang.proficiency} of 5`}>
									{[1, 2, 3, 4, 5].map((step) => (
										<div class={`w-4 h-2 rounded ${lang.proficiency >= step ? 'bg-primary' : 'bg-base-300'}`}></div>
									))}
								</div>
							</div>
						</div>
					))}
				</div>
			)}

			{section.key === 'memberships' && (
				<div class='space-y-4'>
					{memberships.map((item) => (
						<div class='border-l-2 border-primary/30 pl-4'>
							<h3 class='text-lg font-semibold'>{item.organization}</h3>
							<p class='text-sm text-base-content/60 font-medium'>{item.time}</p>
						</div>
					))}
				</div>
			)}

			{section.key === 'interests' && (
				<div class='grid grid-cols-1 md:grid-cols-2 gap-4'>
					{interests.map((item) => (
						<div class='p-4 bg-base-200 rounded-lg'>
							<div class='flex items-center gap-2 mb-2'>
								<div class='text-primary'>
									<IconRenderer name={item.icon} size='md' />
								</div>
								<h3 class='font-semibold text-base-content'>{item.title}</h3>
							</div>
							<p class='text-sm text-base-content/70'>{item.description}</p>
						</div>
					))}
				</div>
			)}
		</section>
	))}
</div>
</Layout>
